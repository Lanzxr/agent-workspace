# QQ Bot channel configuration
QQBOT_APP_ID=
QQBOT_CLIENT_SECRET=
QQBOT_API_BASE_URL=https://api.bot.qq.com
QQBOT_ALLOWED_PUBLICATIONS=
# Leave execution disabled unless DSH tasks from QQ are explicitly trusted.
QQBOT_AUTO_EXECUTE_CAPABILITIES=
COMPANY_AGENT_QQ_WORKSPACE=qq-agent

# AnythingLLM knowledge base. Leave all required values empty to disable ingestion.
ANYTHINGLLM_BASE_URL=http://127.0.0.1:3001
ANYTHINGLLM_API_KEY=
COMPANY_AGENT_KNOWLEDGE_GRANT_SECRET=
COMPANY_AGENT_KNOWLEDGE_ADMIN_USER_IDS=
COMPANY_AGENT_KNOWLEDGE_MAX_FILE_BYTES=524288000
COMPANY_AGENT_KNOWLEDGE_API_HOST=127.0.0.1
COMPANY_AGENT_KNOWLEDGE_API_PORT=8766
COMPANY_AGENT_KNOWLEDGE_API_KEY=
COMPANY_AGENT_KNOWLEDGE_WORKSPACE_PREFIX=company-agent
ANYTHINGLLM_REQUEST_TIMEOUT_SECONDS=180
ANYTHINGLLM_OCR_LANG=chi_sim,eng
ANYTHINGLLM_OCR_DATA_BASE_URL=https://cdn.jsdelivr.net/npm/@tesseract.js-data

# DSSuperAgent asks this loopback gate before every web search/fetch call.
# Only one process owns this port. Use qq for deployments without admin-serve.
COMPANY_AGENT_WEB_GATE_OWNER=admin
COMPANY_AGENT_KNOWLEDGE_API_OWNER=admin
COMPANY_AGENT_WEB_GATE_HOST=127.0.0.1
COMPANY_AGENT_WEB_GATE_PORT=8767
# DSSuperAgent uses this URL for every controlled search/fetch authorization request.
COMPANY_AGENT_WEB_GATE_URL=http://127.0.0.1:8767/internal/web/authorize
# Leave empty on loopback; otherwise use the same 32+ character bridge key on DSSuperAgent.
COMPANY_AGENT_WEB_GATE_API_KEY=
COMPANY_AGENT_WEB_SEARCH_URL=http://127.0.0.1:8888/search
COMPANY_AGENT_WEB_SEARCH_TIMEOUT_SECONDS=20
# DSH task web access is controlled separately from DSSuperAgent web access.
AGENT_WEB_SEARCH_ENABLED=false
# DSH task timeout safety ceiling, idle timeout, compaction timeout, and soft wrap-up reserve (seconds).
AGENT_DSH_TIMEOUT_SECONDS=3600
AGENT_DSH_MAX_TIMEOUT_SECONDS=7200
AGENT_DSH_IDLE_TIMEOUT_SECONDS=600
AGENT_DSH_COMPACTION_TIMEOUT_SECONDS=600
AGENT_DSH_SOFT_WRAPUP_SECONDS=300
# This is the initial value only; the control console setting takes effect immediately.
AGENT_DSSUPERAGENT_WEB_SEARCH_ENABLED=false
COMPANY_AGENT_ADMIN_TOKEN=

# Controlled MCP servers (non-secret JSON definitions; secrets stay in host env vars referenced via env_refs / header_env_refs).
# Example: COMPANY_AGENT_MCP_SERVERS='[{"server_id":"demo_ro","description":"只读查询示例","transport":"stdio","access_level":"internal","command":"python3","args":["/opt/mcp/server.py"],"env_refs":{"SERVICE_TOKEN":"COMPANY_AGENT_MCP_SECRET_DEMO"}}]'
COMPANY_AGENT_MCP_SERVERS=
# COMPANY_AGENT_MCP_SECRET_DEMO=

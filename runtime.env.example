# ==============================================================================
# 1. 模型接口与主备自动切换容灾（必填；部署后也可在 Web 控制台热修改）
# ==============================================================================
AGENT_MODEL_URL=https://api.example.com/v1
AGENT_MODEL_NAME=deepseek-v4.1-flash
AGENT_MODEL_API_KEY=
# 可选容量与思考预算（默认上下文 1048576，最大输出 393216；推理等级可选 off/low/medium/high）
# AGENT_MODEL_CONTEXT_WINDOW=1048576
# AGENT_MODEL_MAX_TOKENS=393216
# AGENT_MODEL_REASONING_EFFORT=
# 可选备用模型（当主模型在无工具副作用的启动阶段报上游错误时自动切换重跑 1 次）
# AGENT_MODEL_FALLBACK_NAME=
# AGENT_MODEL_FALLBACK_URL=
# AGENT_MODEL_FALLBACK_API_KEY=

# ==============================================================================
# 2. 本地管理控制台与低冲突回环端口体系（默认 127.0.0.1:28765-28771）
# ==============================================================================
# 必填：至少 24 位强随机管理员令牌（用于登录 http://127.0.0.1:28765）
COMPANY_AGENT_ADMIN_TOKEN=
# 若局部端口冲突，设置 COMPANY_AGENT_PORT_BASE 即可一键平移全部 7 个默认端口（base+0 .. base+6）
# COMPANY_AGENT_PORT_BASE=28765
# COMPANY_AGENT_ADMIN_PORT=28765
# COMPANY_AGENT_KNOWLEDGE_API_PORT=28766
# COMPANY_AGENT_WEB_GATE_PORT=28767
# COMPANY_AGENT_FORGE_MCP_PORT=28768
# COMPANY_AGENT_DSSUPERAGENT_PORT=28769
# COMPANY_AGENT_SEARCH_PORT=28770
# COMPANY_AGENT_ANYTHINGLLM_PORT=28771

# ==============================================================================
# 3. 机器人渠道接入（QQ 与企业微信可单开或双开；也可在 Web 控制台热修改）
# ==============================================================================
# 3a. QQ 官方机器人（可选）
QQBOT_APP_ID=
QQBOT_CLIENT_SECRET=
QQBOT_API_BASE_URL=https://api.bot.qq.com
QQBOT_ALLOWED_PUBLICATIONS=group_update
# 设为 dsh.task 即允许 QQ 会话提案自动进入 DSH 沙箱执行
QQBOT_AUTO_EXECUTE_CAPABILITIES=dsh.task
COMPANY_AGENT_QQ_WORKSPACE=qq-agent
# COMPANY_AGENT_QQ_ISOLATE_WORKSPACES=true

# 3b. 企业微信（WeCom）智能机器人 WebSocket 长连接（可选，无需公网回调域名）
WECOM_BOT_ID=
WECOM_BOT_SECRET=
WECOM_WS_URL=wss://openws.work.weixin.qq.com
WECOM_ALLOWED_PUBLICATIONS=group_update
WECOM_AUTO_EXECUTE_CAPABILITIES=dsh.task
COMPANY_AGENT_WECOM_WORKSPACE=wecom-agent
# COMPANY_AGENT_WECOM_ISOLATE_WORKSPACES=true
# WECOM_GROUP_DIRECT_ON_CALLBACK=true

# ==============================================================================
# 4. 长期资料库 AnythingLLM（可选；全部留空则禁用资料库入库）
# ==============================================================================
ANYTHINGLLM_BASE_URL=http://127.0.0.1:28771
ANYTHINGLLM_API_KEY=
COMPANY_AGENT_KNOWLEDGE_GRANT_SECRET=
COMPANY_AGENT_KNOWLEDGE_ADMIN_USER_IDS=
COMPANY_AGENT_KNOWLEDGE_MAX_FILE_BYTES=524288000
COMPANY_AGENT_KNOWLEDGE_API_HOST=127.0.0.1
COMPANY_AGENT_KNOWLEDGE_API_PORT=28766
COMPANY_AGENT_KNOWLEDGE_API_KEY=
COMPANY_AGENT_KNOWLEDGE_API_OWNER=admin
COMPANY_AGENT_KNOWLEDGE_WORKSPACE_PREFIX=company-agent
ANYTHINGLLM_REQUEST_TIMEOUT_SECONDS=180
ANYTHINGLLM_OCR_LANG=chi_sim,eng
ANYTHINGLLM_OCR_DATA_BASE_URL=https://cdn.jsdelivr.net/npm/@tesseract.js-data

# ==============================================================================
# 5. 受控联网检索与 DSH 执行超时策略
# ==============================================================================
COMPANY_AGENT_WEB_GATE_OWNER=admin
COMPANY_AGENT_WEB_GATE_HOST=127.0.0.1
COMPANY_AGENT_WEB_GATE_PORT=28767
COMPANY_AGENT_WEB_GATE_URL=
COMPANY_AGENT_WEB_GATE_API_KEY=
COMPANY_AGENT_WEB_SEARCH_URL=http://127.0.0.1:28770/search
COMPANY_AGENT_WEB_SEARCH_TIMEOUT_SECONDS=20
# 初始开关值；启动后在 Web 控制台切换立即生效
AGENT_WEB_SEARCH_ENABLED=false
AGENT_DSSUPERAGENT_WEB_SEARCH_ENABLED=false
# DSH 任务超时、空闲超时、上下文压缩超时与软收尾预留秒数
AGENT_DSH_TIMEOUT_SECONDS=3600
AGENT_DSH_MAX_TIMEOUT_SECONDS=7200
AGENT_DSH_IDLE_TIMEOUT_SECONDS=600
AGENT_DSH_COMPACTION_TIMEOUT_SECONDS=600
AGENT_DSH_SOFT_WRAPUP_SECONDS=300

# ==============================================================================
# 6. 受控外部 MCP 与 Tool Forge 动态工具工坊
# ==============================================================================
# 静态外部 MCP 定义（密钥仅写环境变量名引用，明文密钥放同文件 COMPANY_AGENT_MCP_SECRET_*）
# 示例: COMPANY_AGENT_MCP_SERVERS=[{"server_id":"demo_ro","description":"只读查询示例","transport":"streamable-http","access_level":"internal","url":"http://127.0.0.1:18766/mcp","header_env_refs":{"Authorization":"Bearer ${COMPANY_AGENT_MCP_SECRET_DEMO}"}}]
COMPANY_AGENT_MCP_SERVERS=
# COMPANY_AGENT_MCP_SECRET_DEMO=

COMPANY_AGENT_FORGE_MCP_ENABLED=true
COMPANY_AGENT_FORGE_MCP_HOST=127.0.0.1
COMPANY_AGENT_FORGE_MCP_PORT=28768
COMPANY_AGENT_FORGE_MCP_OWNER=admin

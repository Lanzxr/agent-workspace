# Copy this template to the private runtime directory and fill in external services.
# Never commit the completed env file.
ANYTHINGLLM_LLM_BASE_URL=https://api.example.com/v1
ANYTHINGLLM_LLM_MODEL=your-chat-model
ANYTHINGLLM_LLM_API_KEY=

# Embeddings must be provided by an external OpenAI-compatible service.
ANYTHINGLLM_EMBEDDING_BASE_URL=https://api.example.com/v1
ANYTHINGLLM_EMBEDDING_MODEL=your-embedding-model
ANYTHINGLLM_EMBEDDING_API_KEY=

# OCR languages used for images and scanned PDFs. The compose preflight caches
# these Tesseract.js models in the persistent AnythingLLM storage volume.
ANYTHINGLLM_OCR_LANG=chi_sim,eng
ANYTHINGLLM_OCR_DATA_BASE_URL=https://cdn.jsdelivr.net/npm/@tesseract.js-data

# Optional outbound proxy. Leave empty when the host has direct internet access.
ANYTHINGLLM_HTTP_PROXY=
ANYTHINGLLM_HTTPS_PROXY=
ANYTHINGLLM_NO_PROXY=localhost,127.0.0.1,::1

[Unit]
Description=Company Agent role %i
After=network-online.target docker.service
Wants=network-online.target docker.service

[Service]
Type=simple
User=lan_z
Group=lan_z
Environment=HOME=/home/lan_z
Environment=PYTHONUNBUFFERED=1
Environment=COMPANY_AGENT_GATEWAY_TIMEOUT=20
WorkingDirectory=/home/lan_z/company-agent-deploy/current
ExecStart=/home/lan_z/.local/share/company-agent/venv/bin/python /home/lan_z/company-agent-deploy/current/run-release.py %i
Restart=on-failure
RestartSec=5
UMask=0077

[Install]
WantedBy=multi-user.target
